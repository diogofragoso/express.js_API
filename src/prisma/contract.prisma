// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Cliente {
  id          Int          @id(map: "cliente_pkey") @default(autoincrement())
  createdAt   Timestamptz  @default(now())
  email       String       @unique(map: "cliente_email_key")
  name        String
  telClientes TelCliente[]

  @@map("cliente")
}

model Estudante {
  id             Int       @id(map: "estudante_pkey") @default(autoincrement())
  createdAt      Timestamp @default(now()) @map("created_at")
  nomeEstudante  String    @map("nome_estudante")
  emailEstudante String    @map("email_estudante")

  @@map("estudante")
}

model TelCliente {
  id             Int     @id(map: "tel_cliente_pkey") @default(autoincrement())
  idTelClienteFk Int     @map("id_tel_cliente_fk")
  telCliente     String  @map("tel_cliente")
  cliente        Cliente @relation(fields: [idTelClienteFk], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "tel_cliente_fk", index: false)

  @@map("tel_cliente")
}

model User {
  id        Int         @id(map: "user_pkey") @default(autoincrement())
  createdAt Timestamptz @default(now())
  email     String      @unique(map: "user_email_key")
  name      String?
  password  String

  @@map("user")
}
